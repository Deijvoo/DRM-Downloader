{
  "manifest_version": 3,
  "name": "Voyo Downloader",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Send the episode playing in your Voyo tab to your local downloader.",
  "key": "",
  "permissions": [
    "activeTab",
    "webRequest",
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://*.markiza.sk/*",
    "https://*.cdn.cra.cz/*",
    "https://drm-widevine-licensing.axprod.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voyo Downloader"
  }
}
